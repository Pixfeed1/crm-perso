# Configuration de la base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=crm_db

# Configuration du serveur
PORT=5000

# Origines autorisees pour CORS (liste blanche, separees par des virgules, sans espace superflu)
ALLOWED_ORIGINS=https://crm.pixfeed.net

# Secret partage pour authentifier les appels webhook (en-tete X-Webhook-Secret).
# A definir avec une valeur longue et aleatoire (ex: openssl rand -hex 32).
WEBHOOK_SECRET=

# Configuration email (SMTP)
# Serveur SMTP (exemple: mail.votre-domaine.com, smtp.gmail.com)
EMAIL_HOST=mail.votre-domaine.com

# Port SMTP (587 pour TLS, 465 pour SSL, 25 pour non-sécurisé)
EMAIL_PORT=587

# Utiliser SSL (true pour port 465, false pour port 587)
# EMAIL_USE_SSL=true force le SSL direct ; sinon le port 465 active SSL, 587 utilise STARTTLS.
EMAIL_USE_SSL=
EMAIL_USE_TLS=

# Identifiants SMTP
EMAIL_USER=contact@votre-domaine.com
EMAIL_PASSWORD=votre_mot_de_passe

# Nom de l'expéditeur qui apparaîtra dans les emails
EMAIL_FROM_NAME=Mon Entreprise

# Rapports de maintenance : expéditeur et adresse de réponse de l'email d'accompagnement
REPORT_FROM_NAME=Pixfeed
REPORT_FROM=contact@pixfeed.net
REPORT_REPLY_TO=moosyne@gmail.com
# Téléphone affiché dans le pied de page du rapport (optionnel)
REPORT_PHONE=06.45.37.39.30
# Destinataire des alertes internes "rapport à préparer" (sinon REPORT_REPLY_TO, sinon EMAIL_USER)
ALERT_EMAIL=moosyne@gmail.com
# Délai (en jours) avant l'échéance pour l'alerte de préparation (défaut 1 = la veille)
REPORT_REMINDER_DAYS_AHEAD=1

# Instructions pour obtenir les identifiants SMTP :
# 1. Si vous avez un nom de domaine avec hébergement :
#    - Connectez-vous à votre panneau de contrôle (cPanel, Plesk, etc.)
#    - Créez une adresse email (ex: contact@votre-domaine.com)
#    - Notez les paramètres SMTP fournis par votre hébergeur
#
# 2. Si vous utilisez Gmail :
#    - EMAIL_HOST=smtp.gmail.com
#    - EMAIL_PORT=587
#    - EMAIL_SECURE=false
#    - EMAIL_USER=votre.email@gmail.com
#    - EMAIL_PASSWORD=mot_de_passe_application (pas votre mot de passe Gmail !)
#    - Activez l'authentification à 2 facteurs et créez un mot de passe d'application
#
# 3. Si vous utilisez Outlook/Hotmail :
#    - EMAIL_HOST=smtp-mail.outlook.com
#    - EMAIL_PORT=587
#    - EMAIL_SECURE=false
#    - EMAIL_USER=votre.email@outlook.com
#    - EMAIL_PASSWORD=votre_mot_de_passe

# API France Travail (anciennement Pôle Emploi) - Gratuit
# Documentation: https://francetravail.io/produits-partages/catalogue/offres-emploi/documentation
# Pour obtenir vos clés :
# 1. Créer un compte sur https://francetravail.io (ou pole-emploi.io redirige)
# 2. Créer une application "CRM Prospection"
# 3. Cocher les scopes : api_offresdemploiv2 et o2dsoffre
# 4. Récupérer Client ID et Client Secret
POLE_EMPLOI_CLIENT_ID=votre_client_id
POLE_EMPLOI_CLIENT_SECRET=votre_client_secret
POLE_EMPLOI_SCOPE=api_offresdemploiv2 o2dsoffre

# API Google Jobs via JSearch (RapidAPI) - Gratuit (500 requêtes/mois)
# Documentation: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Pour obtenir votre clé gratuite :
# 1. Créer un compte sur https://rapidapi.com (inscription gratuite)
# 2. Rechercher "JSearch" dans le catalogue
# 3. S'abonner au plan "Basic" (gratuit, 500 requêtes/mois)
# 4. Copier votre clé API RapidAPI (X-RapidAPI-Key)
# Note: Cette clé est optionnelle. Si non configurée, seul France Travail sera utilisé.
JSEARCH_API_KEY=votre_rapidapi_key

# API SIRENE (INSEE) - Gratuit
# Documentation: https://api.insee.fr/catalogue/site/themes/wso2/subthemes/insee/pages/item-info.jag?name=Sirene&version=V3&provider=insee
# Pour obtenir vos clés OAuth2 :
# 1. Créer un compte sur https://api.insee.fr/
# 2. Créer une application dans votre espace "Mes applications"
# 3. Souscrire à l'API Sirene V3 (gratuite)
# 4. Récupérer votre Consumer Key et Consumer Secret
# 5. Les clés permettent l'authentification OAuth2
# Note: Cette API permet de rechercher toutes les entreprises françaises par code NAF, ville, département, etc.
INSEE_CONSUMER_KEY=votre_consumer_key
INSEE_CONSUMER_SECRET=votre_consumer_secret

# API Pappers - Gratuit (100 requêtes/mois)
# Documentation: https://www.pappers.fr/api/documentation
# Pour obtenir votre token API :
# 1. Créer un compte gratuit sur https://www.pappers.fr/
# 2. Aller dans "Mon compte" > "API"
# 3. Copier votre clé API (token)
# 4. Le plan gratuit offre 100 requêtes/mois
# Note: Cette API enrichit les données SIRENE avec téléphone, email, site web, dirigeants, etc.
# Le compteur de crédits est géré automatiquement par le backend dans backend/data/pappers-credits.json
PAPPERS_API_TOKEN=votre_pappers_token

# Google Calendar API - Gratuit
# Documentation: https://developers.google.com/calendar/api/guides/overview
# Pour obtenir vos identifiants OAuth2 :
# 1. Créer un projet sur https://console.cloud.google.com/
# 2. Activer l'API Google Calendar
# 3. Créer des identifiants OAuth 2.0 (Application Web)
# 4. Ajouter l'URL de redirection: http://localhost:5000/api/calendar-sync/google/callback
# 5. Télécharger les identifiants (Client ID et Client Secret)
GOOGLE_CLIENT_ID=votre_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar-sync/google/callback
# Connexion Google SEO (Search Console + Analytics) en un clic depuis la page SEO : reutilise
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET. Declarer dans la console Google, sur ce client
# « Application Web », l'URI de redirection : <FRONTEND_URL>/api/seo/google/callback
# (ex. https://crm.pixfeed.net/api/seo/google/callback). Surcharge possible :
# SEO_GOOGLE_REDIRECT_URI=

# Microsoft Outlook Calendar API (Microsoft Graph) - Gratuit
# Documentation: https://docs.microsoft.com/graph/api/resources/calendar
# Pour obtenir vos identifiants OAuth2 :
# 1. Créer une application sur https://portal.azure.com/ (Azure Portal)
# 2. Aller dans "App registrations" et créer une nouvelle application
# 3. Ajouter une "Web" platform avec l'URL de redirection
# 4. Dans "Certificates & secrets", créer un nouveau "Client secret"
# 5. Dans "API permissions", ajouter : User.Read, Calendars.ReadWrite (déléguées)
MICROSOFT_CLIENT_ID=votre_microsoft_client_id
MICROSOFT_CLIENT_SECRET=votre_microsoft_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/calendar-sync/outlook/callback

# URL du frontend (pour les redirections OAuth)
FRONTEND_URL=http://localhost:3000

# Stripe : clé secrète serveur (prélèvement des contrats de maintenance). Ne jamais exposer.
STRIPE_SECRET_KEY=sk_live_xxx
# Stripe : secret de signature du webhook (POST /api/maintenance-billing/stripe-webhook).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ===== Agent "Veille missions" (annonces freelance) =====
# API Jooble - cle gratuite sur https://jooble.org/api/about (recue par email)
JOOBLE_API_KEY=votre_cle_jooble

# API Anthropic (qualification LLM des annonces + redaction d'emails de prospection)
# https://console.anthropic.com/  -  Modele utilise : claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=votre_cle_anthropic

# Identite de l'expediteur pour les emails de prospection rediges par Claude.
# OUTREACH_SENDER_NAME vide -> Claude signe avec le nom de l'entreprise (jamais un faux prenom).
OUTREACH_SENDER_NAME=Marc
OUTREACH_SENDER_COMPANY=PixFeed
OUTREACH_SENDER_ROLE=creation et refonte de sites web

# URL publique de l'app (base des liens de tracking d'ouverture/clic des emails).
APP_BASE_URL=https://crm.pixfeed.net

# ─── Suivi de positions (worker SEO / Search Console) ───
# Filtre pour que la position affichee colle au SERP REEL (et pas a une moyenne
# mondiale tous appareils). GSC_COUNTRY : code pays ISO-3 (ex 'fra'). Vide = monde.
# GSC_DEVICE : 'desktop' | 'mobile' | 'tablet'. Vide = tous appareils. Defaut : fra.
GSC_COUNTRY=fra
GSC_DEVICE=

# ─── Module Backlinks (suite SEO) — canal SÉPARÉ du pipeline client ───
# Envoi des demandes de lien depuis le Gmail PERSO (mot de passe d'application,
# necessite la validation en 2 etapes sur le compte Google). Limite: 500 dest/24h.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Open PageRank (gratuit, 30 000 domaines/mois) - cle sur openpagerank/Keywords Everywhere.
OPR_API_KEY=
# CrUX (optionnel, gratuit, 150 req/min) - presence = trafic reel mesure par Google.
CRUX_API_KEY=
# Bing Webmaster Tools (liens entrants des sites SEO, job 'authority' du worker) : meme cle
# que BING_WMT_API_KEY du serveur MCP (Bing WMT > Parametres > API access). Le site doit
# etre verifie dans Bing WMT sous ce compte. Gratuit.
BING_WMT_API_KEY=
# PageSpeed Insights (Core Web Vitals des sites SEO, job 'pagespeed' du worker). Cle Google
# Cloud avec l'API "PageSpeed Insights" activee ; a defaut CRUX_API_KEY est reutilisee.
# Sans cle : quota anonyme bas, la mesure peut s'arreter en 429.
PAGESPEED_API_KEY=
# Planification nocturne du worker SEO (mode --serve) : chaque jour a SEO_SCHEDULE_HOUR
# (heure SEO_SCHEDULE_TZ), pour chaque site : crawl incremental (complet le jour
# SEO_SCHEDULE_FULL_WEEKDAY, 0 = lundi ... 6 = dimanche, -1 = jamais), synchro Search
# Console, mesure de vitesse. SEO_SCHEDULE=0 desactive (tout redevient manuel).
SEO_SCHEDULE=1
SEO_SCHEDULE_HOUR=4
SEO_SCHEDULE_TZ=Europe/Paris
SEO_SCHEDULE_FULL_WEEKDAY=6
# Rotation : a chaque run, accueil + PSI_TOP_PAGES pages les plus vues (mobile ET desktop)
# + PSI_ROTATION_PAGES pages jamais mesurees / les plus anciennes (mobile). Le site entier
# est couvert en quelques semaines sans bloquer le worker.
PSI_TOP_PAGES=10
PSI_ROTATION_PAGES=30
# Outils de decouverte (chemins sur le serveur).
LINKGRAPH_SCRIPT=/home/jurojinn/tools/linkgraph/linkgraph.py
LINKGRAPH_DATA_DIR=/home/jurojinn/tools/linkgraph/data

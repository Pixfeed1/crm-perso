# mcp_seo/.env — NE JAMAIS COMMITER (gitignoré). Copier en .env et remplir sur serveur2.

# Token Bearer (>= 40 caractères ALÉATOIRES). Générer p.ex. :  openssl rand -hex 32
MCP_SEO_TOKEN=

# Port d'écoute local (le TLS est géré par nginx en façade).
MCP_SEO_PORT=8790

# Rate limit (requêtes / minute / IP).
MCP_SEO_RATE_MAX=60

# Connexion base : utiliser le rôle DÉDIÉ SELECT-only (cf. setup.sql), JAMAIS le user CRM.
MCP_DB_HOST=localhost
MCP_DB_PORT=5432
MCP_DB_USER=mcp_seo_ro
MCP_DB_PASSWORD=
MCP_DB_NAME=jurojinn_mcrm

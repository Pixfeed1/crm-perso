[Unit]
Description=CRM MCP SEO (connecteur lecture seule des données SEO pour Claude)
After=network.target postgresql.service

[Service]
Type=simple
# Tourne sous le compte propriétaire du projet.
User=jurojinn
Group=jurojinn
WorkingDirectory=/home/jurojinn/crm.pixfeed.net/mcp_seo
EnvironmentFile=/home/jurojinn/crm.pixfeed.net/mcp_seo/.env
# Adapter si node n'est pas dans /usr/bin (vérifier avec `which node`).
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
# Durcissement systemd.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Le projet est dans /home -> NE PAS mettre ProtectHome=true (rendrait /home inaccessible).
ProtectHome=false
ReadWritePaths=/home/jurojinn/crm.pixfeed.net/mcp_seo

[Install]
WantedBy=multi-user.target

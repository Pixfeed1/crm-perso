# Configuration pour le mode production
# URL RELATIVE de l'API (pas d'URL complète pour éviter CORS)

# URL de l'API backend (relatif = même origine)
REACT_APP_API_URL=/api

# En production, Node.js sert à la fois le frontend React ET l'API
# Apache fait juste le proxy HTTPS → Node.js
# Cette config évite tous les problèmes de CORS et Mixed Content

# Pas de source maps en production : elles exposent le code source lisible
# (et les commentaires) a quiconque ouvre les outils de developpement.
GENERATE_SOURCEMAP=false

# Le petit script d'amorcage webpack est ecrit dans un fichier au lieu d'etre
# incruste dans index.html : c'est ce qui permet une CSP script-src 'self' stricte,
# sans 'unsafe-inline' ni nonce.
INLINE_RUNTIME_CHUNK=false
